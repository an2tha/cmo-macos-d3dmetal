<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>CommandBrowser</AssemblyName>
    <StartupObject>BrowserBootstrap</StartupObject>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="WindowsFormsIntegration" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <PackageReference Include="Lib.Harmony" Version="2.3.3" GeneratePathProperty="true" PrivateAssets="all" ExcludeAssets="runtime" />
    <EmbeddedResource Include="$(PkgLib_Harmony)/lib/net48/0Harmony.dll" LogicalName="CommandBrowser.0Harmony.dll" />
    <None Include="../CommandMetal/App.config" Link="App.config" />
  </ItemGroup>
</Project>
